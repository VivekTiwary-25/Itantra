<?xml version="1.0" encoding="utf-8"?>
<!-- Film-demo builds (demoVachana / demoYash / demoVivek) only.
     Replaces the real launcher with DemoActivity and strips the real
     networking/diagnostic entry points; the real code stays in the APK
     untouched but unreachable. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Short (3-10 s) deterministic director-console timers. USE_EXACT_ALARM is
         auto-granted on API 33+; SCHEDULE_EXACT_ALARM covers API 31-32. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application tools:replace="android:label" android:label="@string/app_name">
        <activity
            android:name="com.chmod777.itantra.MainActivity"
            tools:node="remove" />
        <activity
            android:name="com.chmod777.itantra.ui.lab.NetworkLabActivity"
            tools:node="remove" />
        <service
            android:name="com.chmod777.itantra.service.EmergencyModeService"
            tools:node="remove" />

        <activity
            android:name="com.chmod777.itantra.demo.DemoActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ITantraDemo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.chmod777.itantra.demo.DemoEventReceiver"
            android:exported="false" />
    </application>
</manifest>
