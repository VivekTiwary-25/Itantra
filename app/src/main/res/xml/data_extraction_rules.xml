<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for API 31+ (spec audit F). See backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="itantra_net.db" />
        <exclude domain="database" path="itantra_net.db-wal" />
        <exclude domain="database" path="itantra_net.db-shm" />
        <exclude domain="database" path="itantra_net.db-journal" />
        <exclude domain="sharedpref" path="itantra_networking.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="itantra_net.db" />
        <exclude domain="database" path="itantra_net.db-wal" />
        <exclude domain="database" path="itantra_net.db-shm" />
        <exclude domain="database" path="itantra_net.db-journal" />
        <exclude domain="sharedpref" path="itantra_networking.xml" />
    </device-transfer>
</data-extraction-rules>
