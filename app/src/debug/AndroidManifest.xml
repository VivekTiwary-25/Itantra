<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a launcher entry for the Batch-1 networking diagnostic screen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".ui.lab.NetworkLabActivity"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Physical-validation control plane. Only holders of DUMP (adb shell) can send to it. -->
        <receiver
            android:name=".debug.ValidationReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
